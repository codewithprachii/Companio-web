# Companio configuration
# Copy this file to .env and adjust values

# Neon / hosted PostgreSQL connection string (asyncpg driver).
# The Database URL should be in this form:
#   postgresql+asyncpg://<user>:<password>@<host>:5432/<dbname>?sslmode=require
# Adjust for your Neon project. Keep ?sslmode=require for Neon.
DATABASE_URL=postgresql+asyncpg://YOUR_NEON_USER:YOUR_NEON_PASSWORD@YOUR_NEON_HOST:5432/neondb?sslmode=require

# App settings
APP_NAME=Companio
APP_VERSION=0.1.0
DEBUG=false
